# Use the same PostgreSQL database URL for Vercel and Render if both
# deployments should share the same GillBill data.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="generate-a-long-random-secret"

# Create a Vercel Blob store and use its read/write token on both platforms.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional; otherwise VERCEL_URL / RENDER_EXTERNAL_URL is used for reset links.
APP_URL="https://your-domain.example"
