# Use the same MongoDB Atlas URL on Vercel and Render if both deployments
# should share GillBill data. URL-encode special characters in the password.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gillbill?retryWrites=true&w=majority"
AUTH_SECRET="generate-a-long-random-secret"
SUPER_ADMIN_EMAIL="your-admin-email@example.com"

# Create a Vercel Blob store and use its read/write token on both platforms.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional canonical URL used for links such as password resets.
# Set to https://gill-bill.vercel.app on Vercel, or your Render service URL on Render.
APP_URL="https://gill-bill.vercel.app"
